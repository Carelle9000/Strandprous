rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contact form — public write, SA reads/updates/deletes without Firebase Auth
    match /contacts/{id} {
      allow read, write, delete, update: if true;
    }

    // Salon registry — SA (localStorage auth) needs full access; owners sync at login
    match /salons/{salonId} {
      allow read, write, delete, update: if true;

      // Sub-collections owner data (inventory, staff, etc.) — owner only via REST API key
      match /{subCollection}/{docId} {
        allow read, write, delete, update: if true;
      }

      // Public booking — clients can create Pending appointments without login
      match /appointments/{appointmentId} {
        allow create: if request.resource.data.status == 'Pending'
                      && request.resource.data.source == 'public_booking';
        allow read, update, delete: if true;
      }
    }

    // Relay GAS → strandpro.html : résultats temporaires écrits par GAS, lus puis supprimés par le client
    match /gasResults/{id} {
      allow read, write, delete, update: if true;
    }

    // OTP codes for password reset — Cloud Functions seulement pour écrire
    // Users peuvent lire le leur pour vérifier (public car pas d'auth requise)
    match /otpResetCodes/{email} {
      allow create, write, update, delete: if false; // Cloud Functions utilisent les credentails d'admin
      allow read: if true; // Public read (rate limit + short expiry provides security)
    }

    // OTP attempts tracking — rate limiting pour password reset (public, car utilisateur non authentifié)
    match /otpAttempts/{email} {
      allow read, write, delete, update: if true;
    }

    match /users/{id} {
      allow read, write: if request.auth != null;
    }

    match /appointments/{id} {
      allow read, write: if request.auth != null;
    }

    match /customers/{id} {
      allow read, write: if request.auth != null;
    }

    match /services/{id} {
      allow read, write: if request.auth != null;
    }

    match /staff/{id} {
      allow read, write: if request.auth != null;
    }

    match /inventory/{id} {
      allow read, write: if request.auth != null;
    }

    match /settings/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
